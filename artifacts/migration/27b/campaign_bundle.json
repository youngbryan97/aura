 "experiments": {
  "generalization": {
   "authorizes": "a wider bounded claim if it passes; never ordinary chat and never global serving",
   "cohort": "held-out families, frozen before the recovery run is read",
   "goal": "whether the recovered gain reaches families it was not trained on",
   "precondition": "recovery adjudicated positive"
  },
  "never_authorized_by_training_completion": [
   "ordinary_chat_authorized",
   "arbitrary_reasoning_authorized",
   "global runtime promotion",
   "static weight fusion",
   "frontier performance"
  ],
  "recovery": {
   "arms": [
    "treatment",
    "ordinary_base",
    "matched_wire_base",
    "coefficient_lesion",
    "matched_wrong_state"
   ],
   "authorizes": "a bounded 27B claim on these four executable families and nothing else",
   "cohort": "frozen four-domain semantic cohort, 15 tasks per family",
   "decodes": 300,
   "goal": "re-earn the CP566 bounded claim on the 27B, on the same frozen four-domain cohort and the same arm structure",
   "success": "treatment beats ordinary_base with zero regressions, every family separates under lesion, paired one-sided exact p < 0.01",
   "task_count": 60
  }
 },
 "futility_gates": [
  {
   "after": "calibration",
   "measure": "ordinary_base_parsed_fraction",
   "reason": "if ordinary decode cannot even produce parseable answers on the cohort, a gain over it is not a reasoning result",
   "stops_when": "< 0.2"
  },
  {
   "after": "calibration",
   "measure": "grounding_contract_status",
   "reason": "an ungrounded tokenizer makes every typed comparison meaningless",
   "stops_when": "!= complete"
  },
  {
   "after": "training",
   "measure": "heldout_state_accuracy_delta_vs_initialization",
   "reason": "trained parameters that do not beat their own initialization control have nothing to serve",
   "stops_when": "<= 0"
  },
  {
   "after": "canary",
   "measure": "treatment_exact",
   "reason": "no gain to adjudicate; stop before spending the lesion arms",
   "stops_when": "<= ordinary_base_exact"
  },
  {
   "after": "lesion_arms",
   "measure": "families_separating_under_lesion",
   "reason": "a gain that survives its own lesion is a decode-budget effect, not a claim about trained coefficients",
   "stops_when": "< all"
  }
 ],
