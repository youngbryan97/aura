# core/capabilities — layering rules. Written, not generated.
#
# One line here is narrower than any generated rule can be. The post-action verifier
# registers an invariant and takes nothing else from core.verify, so the rule
# names the module: `+core.verify.invariants`. A generated DEPS emits
# package-level rules only, so regenerating this widens it to the whole of
# core.verify, the verifier that checks this package included, and the gate
# goes on passing while the rule it was holding is gone.
#
# Everything else below is the closed-world list the generator wrote: what
# this package imports today, and nothing else.

description = "core.capabilities: declared service dependencies plus invariant registration for observation evidence."

include_rules = [
    "+core.capabilities",

    # What this package reaches for today.
    "+core.adapters",
    "+core.agency",
    "+core.brain",
    "+core.capability_engine",
    "+core.container",
    "+core.conversation",
    "+core.executive",
    "+core.governance",
    "+core.governance_context",
    "+core.knowledge",
    "+core.llm",
    "+core.memory",
    "+core.perception",
    "+core.runtime",
    "+core.security",
    "+core.self_modification",
    "+core.skills",
    "+core.utils",
    "+core.verify.invariants",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
