# core/environment — layering rules. Written, not generated.
#
# The `+` lines are what this package imports today, package by package. The
# `-core` line after them forbids the rest, so a new cross-package dependency
# is an edit to this file rather than an import nobody sees. Regenerate with
# `make deps-generate`; replace this file with a written one when this
# package earns a real architectural rule, the way core/runtime/DEPS has.
#
# 12 outbound edges when this was generated.

description = "core.environment: existing dependencies plus the shared concurrency helper for cancellation-safe teardown."

include_rules = [
    "+core.environment",

    # What this package reaches for today.
    "+core.advanced_cognition",
    "+core.brain",
    "+core.config",
    "+core.consciousness",
    "+core.container",
    "+core.conversation",
    "+core.environments",
    "+core.executive",
    "+core.governance_context",
    "+core.memory",
    "+core.perception",
    "+core.runtime",
    "+core.utils.concurrency",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
