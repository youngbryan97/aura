# core/evaluation — layering rules. Written, not generated.
#
# One line here is narrower than any generated rule can be. Steering and
# recurrent evaluation decode the runtime's public channel and take nothing
# else from core.brain, so the rule names the module:
# `+core.brain.llm.public_channel_decode`. A generated DEPS emits package-level
# rules only, so regenerating this widens it to the whole of core.brain, the
# cognition the evaluation is scoring included, and the gate goes on passing
# while the rule it was holding is gone.
#
# Everything else below is the closed-world list the generator wrote: what
# this package imports today, and nothing else.

description = "core.evaluation: may import only what it already imports; every new edge is an edit here."

include_rules = [
    "+core.evaluation",
    # Steering and recurrent evaluation share the runtime's channel contract.
    "+core.brain.llm.public_channel_decode",

    # What this package reaches for today.
    "+core.config",
    "+core.conversation",
    "+core.learning",
    "+core.promotion",
    "+core.runtime",
    "+core.verify",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
