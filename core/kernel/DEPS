# core/kernel — layering rules. Written, not generated.
#
# One line here is narrower than any generated rule can be. Organ startup
# warms the shared sentence encoder the memory organ uses and takes nothing
# else from core.memory, so the rule names the module:
# `+core.memory.embedding_runtime`. A generated DEPS emits package-level rules
# only, so regenerating this widens it to the whole of core.memory and the gate
# goes on passing while the rule it was holding is gone.
#
# Everything else below is the closed-world list the generator wrote: what
# this package imports today, and nothing else.

description = "core.kernel: declared orchestration dependencies, including the shared embedding lifecycle for memory-organ warmup; no other memory internals."

include_rules = [
    "+core.kernel",

    # What this package reaches for today.
    "+core.agency",
    "+core.brain",
    "+core.cognition",
    "+core.config",
    "+core.consciousness",
    "+core.container",
    "+core.continuity",
    "+core.cybernetics",
    "+core.event_bus",
    "+core.executive",
    "+core.goals",
    "+core.governance_context",
    "+core.health",
    "+core.introspection",
    "+core.learning",
    # Organ startup warms the existing shared encoder; it does not own a second model.
    "+core.memory.embedding_runtime",
    "+core.ops",
    "+core.perception",
    "+core.phases",
    "+core.pipeline",
    "+core.resilience",
    "+core.runtime",
    "+core.security",
    # The growth engine enters its language organ's verdict into the growth
    # ledger as a step; it takes nothing else from core.self.
    "+core.self.growth",
    # Keyword markers are matched as words. See core/conversation/word_markers.py.
    "+core.conversation.word_markers",
    # Her history is kept at the close of each tick.
    "+core.self.what_came_before",
    "+core.self_modification",
    "+core.senses",
    "+core.somatic",
    "+core.state",
    "+core.utils",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
