# core/learning — layering rules. Written, not generated.
#
# The list below started as a generated one and the header said so, while the
# generator was already holding the file back by name. So it read as
# disposable to anybody who opened it, and the rule in the description — that
# a learning edge into cognition is allowed for the procedure currency and the
# shared evidence algebra, and every other new core edge stays explicit — was
# a regeneration away from being replaced by whatever the imports happened to
# be that day.
#
# The `+` lines are what this package may reach for. A new cross-package
# dependency is an edit here, on purpose, and it is not `make deps-generate`
# that makes it.
#
# 29 outbound edges after the common procedure currency gained evidence provenance.

description = "core.learning may use cognition's procedure currency and the shared evidence algebra; other new core edges remain explicit."

include_rules = [
    "+core.learning",

    # What this package reaches for today.
    "+core.agi",
    "+core.architecture_quality",
    "+core.brain",
    "+core.cognition",
    "+core.config",
    "+core.consciousness",
    "+core.container",
    # Word-boundary marker matching, so a keyword list here cannot fire on
    # the word it is buried inside. Stdlib-only, no runtime behind it.
    "+core.conversation",
    "+core.event_bus",
    "+core.evidence",
    "+core.executive",
    "+core.governance_context",
    "+core.introspection",
    "+core.language",
    "+core.learning",
    "+core.memory",
    "+core.orchestrator",
    "+core.promotion",
    "+core.reasoning",
    "+core.runtime",
