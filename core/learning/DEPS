    "+core.self_modification",
    "+core.service_names",
    "+core.skills",
    "+core.tasks",
    "+core.utils",
    "+core.will",
    "+core.world_model",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
