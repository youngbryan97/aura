# core/subject — layering rules. Written, not generated.
#
# This package measures the organism; it must never become part of it. The
# rule is one-way: subject may import the runtime it measures, and nothing in
# the runtime may import subject. A measurement that the thing being measured
# can read is a feedback loop, and every number here would then be partly
# about itself.
#
# A generated closed-world list would say something weaker — "what it imports
# today" — and would widen the moment somebody added an import, which is the
# direction this rule exists to hold.

description = "core.subject: may read the organism it measures; the organism may not read it."

include_rules = [
    "+core.subject",

    # What it reads to build K and to drive a life.
    "+core.kernel",
    "+core.memory",
    "+core.ontogeny",
    "+core.state",

    # How it reaches the running organism to take a reading. Every one of
    # these is subject -> runtime, which is the direction the rule allows;
    # named module by module rather than package by package, so a wider reach
    # into any of them is a line in a diff.
    "+core.agency.authorship",
    "+core.consciousness.consciousness_bridge",
    "+core.consciousness.system",
    "+core.container",
    "+core.runtime.service_registry",
    "+core.service_registration",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
