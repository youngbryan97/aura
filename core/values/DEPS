# core/values — layering rules. Written, not generated.
#
# One line here is narrower than any generated rule can be. The heuristic
# imperatives match a principle against the shared word markers and take
# nothing else from core.conversation, so the rule names the module:
# `+core.conversation.word_markers`. A generated DEPS emits package-level
# rules only, so regenerating this widens it to the whole of
# core.conversation — every reply-shaping and delivery module in it — and the
# gate goes on passing while the rule it was holding is gone.
#
# Everything else below is the closed-world list the generator wrote: what
# this package imports today, and nothing else.

description = "core.values: existing dependencies plus the shared word-marker helper for principle matching; no conversation services."

include_rules = [
    "+core.values",

    # What this package reaches for today.
    "+core.agency",
    "+core.config",
    "+core.container",
    "+core.conversation.word_markers",
    "+core.event_bus",
    "+core.governance",
    "+core.runtime",
    "+core.social",
    "+core.utils",

    # Everything else.
    "-core",
    "-interface",
    "-skills",
    "-aura_main",
]
